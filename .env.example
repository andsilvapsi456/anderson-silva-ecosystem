# ── Supabase (https://supabase.com/dashboard → Project Settings → API) ──
# Deixe vazio para rodar em MODO DEMO (dados de exemplo, sem login real)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connection string do Postgres (Prisma) — Supabase → Database → Connection string (pooler)
DATABASE_URL=
DIRECT_URL=

# ── URLs do ecossistema ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# ── SEGREDOS (SEGURANÇA) ──
# Gere cada um com:  openssl rand -hex 32   (NUNCA reutilize o mesmo valor)
# Assinam os links sem-login (confirmar/cancelar sessão, link de cadastro).
# Em produção são OBRIGATÓRIOS — sem eles o sistema cai para um valor de demo.
INTAKE_SECRET=
# Protege os endpoints de cron (Bearer). Obrigatório em produção.
CRON_SECRET=

# ── Notificações (lembretes, agenda diária, cobranças) ──
# Resend (free 100 e-mails/dia): https://resend.com → API Key
RESEND_API_KEY=
EMAIL_FROM="Clínica Anderson Silva <agenda@andersonsilvapsicologo.com.br>"
# Chave PIX exibida nas cobranças
PIX_KEY=hello@andersonsilvapsicologo.com.br

# ── WhatsApp via EVOLUTION API (preferido — conecta o número normal por QR) ──
# Se estas 3 estiverem preenchidas, o sistema envia por aqui (ignora a Meta).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ── WhatsApp Business Cloud API (Meta) — fallback ──
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App Secret do app Meta (Meta for Developers → Configurações → Básico).
# Valida a assinatura X-Hub-Signature-256 do webhook — sem ele, em produção,
# o webhook é RECUSADO (ninguém forja cancelamento/confirmação de sessão).
WHATSAPP_APP_SECRET=

# ── Google Calendar + Meet (link fixo por paciente) ──
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ── Autentique (assinatura digital — contrato automático pós-cadastro) ──
# Token em app.autentique.com.br → Configurações → API
AUTENTIQUE_TOKEN=

# Pagamento: PIX manual (chave Nubank) — sem gateway. A clínica confere o
# PIX e marca "Pago" no painel; o recibo é emitido automaticamente.

# ── Recuperação de senha por SMS (opcional — Twilio/Zenvia) ──
SMS_PROVIDER_TOKEN=

# ── NFS-e Osasco/SP (emissão automática via Focus NFe) ──
# 1) token de integração gerado no portal nfe.osasco.sp.gov.br
# 2) conta Focus NFe (homologação gratuita): https://focusnfe.com.br
FOCUS_NFE_TOKEN=
FOCUS_NFE_AMBIENTE=homologacao
NFSE_PRESTADOR_CNPJ=
NFSE_INSCRICAO_MUNICIPAL=

# ── IA assistiva (Fase 3) ──
ANTHROPIC_API_KEY=
