# Copie para .env (cp .env.example .env) e preencha — o .env é gitignored.

# Subdomínio que aponta para o IP desta VM (registro A no Cloudflare, DNS only)
DOMAIN=evo.andersonsilvapsicologo.com.br

# Chave de acesso à API — gere com: openssl rand -hex 32
# A MESMA chave vai no Cloudflare Worker do admin como EVOLUTION_API_KEY.
EVOLUTION_API_KEY=

# Senha do Postgres interno (só circula dentro do Docker) — openssl rand -hex 16
POSTGRES_PASSWORD=
